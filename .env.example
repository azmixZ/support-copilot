# Everything works without this file: the service is fully local by default.
# DRAFT_BACKEND=local            # local (default) | api — api is a development option only
# ANTHROPIC_API_KEY=             # needed only with DRAFT_BACKEND=api
# ALLOW_P0=1                     # p0 by taxonomy (default); 0 = mark those p1 if a test set has no p0
# HISTORY_DAYS=183               # how long admin edits and ticket history are kept
